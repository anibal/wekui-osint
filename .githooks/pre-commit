#!/bin/sh
# outl sidecar sync — keep committed docs/pages/*.outl in step with the markdown.
#
# docs/ is an outl workspace: each page's .outl sidecar is a projection of its
# .md that outl regenerates. When markdown is edited outside outl (Claude via
# Write/Edit), the sidecar lags until an "adopt" pass runs. This hook runs that
# pass at commit time — but only when it is SAFE to: the ubiquitous-language
# doctrine forbids a second outl process while the GUI/TUI is attached, so when
# one is, we defer to it and only warn.

set -eu
repo="$(git rev-parse --show-toplevel)"
command -v outl >/dev/null 2>&1 || exit 0
[ -d "$repo/docs/.outl" ] || exit 0

# Only act when this commit actually touches the outline.
git diff --cached --name-only | grep -q '^docs/' || exit 0

if pgrep -f outl-desktop >/dev/null 2>&1 \
   || pgrep -f 'outl serve' >/dev/null 2>&1 \
   || pgrep -f 'outl tui'   >/dev/null 2>&1; then
  # An outl GUI/TUI owns the workspace — never start a second writer.
  # Read-only drift check; warn but don't block (Aníbal reconciles in the GUI).
  ( cd "$repo/docs" && outl doctor >/dev/null 2>&1 ) \
    || echo "outl: sidecars may be stale and outl is attached — reconcile in the GUI, or commit with it closed."
  exit 0
fi

# Nothing attached: safe to adopt, then stage the regenerated sidecars so they
# ride in the same commit as the markdown they project.
( cd "$repo/docs" && outl serve --once >/dev/null 2>&1 )
git add "$repo"/docs/pages/*.outl "$repo"/docs/journals/*.outl 2>/dev/null || true
( cd "$repo/docs" && outl doctor >/dev/null 2>&1 ) \
  || { echo "outl doctor found an integrity error — commit blocked. Run: outl -w docs doctor"; exit 1; }
